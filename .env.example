# Optional: explicit path when Codex CLI is not available through PATH.
CODEX_CLI_PATH=

PORT=8787
HOST=127.0.0.1

# Optional override for the bundled public Desktop OAuth client.
GOOGLE_CLIENT_ID=
# Required only for an OAuth client that Google treats as a confidential Web client.
# Keep it only in .env. Never commit or paste this value into source code.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/google/oauth/callback
