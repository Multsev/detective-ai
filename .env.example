# Optional: explicit path when Codex CLI is not available through PATH.
CODEX_CLI_PATH=

PORT=8787
HOST=127.0.0.1

# Optional override for the bundled public Desktop OAuth client.
GOOGLE_CLIENT_ID=
# Optional compatibility value for a Google OAuth registration that requires it.
# Keep the real value only in local .env; never commit it.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/google/oauth/callback
